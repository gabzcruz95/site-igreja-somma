# Variáveis de ambiente do projeto Igreja SôMMA (frontend + funções em /api).
#
# Em produção, configure estas variáveis no painel da Vercel:
# Project > Settings > Environment Variables — nunca as coloque em um
# arquivo .env real dentro do repositório (o .gitignore já bloqueia isso).
#
# Para desenvolvimento local com `npx vercel dev`, copie este arquivo para
# ".env" (mesmo nome, sem ".example") e preencha os valores de TESTE.

# ============================================================
# BACKEND (usado apenas pelas funções em /api — nunca chega ao navegador)
# ============================================================

# Painel do Mercado Pago > Suas integrações > credenciais de TESTE.
# Nunca use uma credencial de produção em desenvolvimento.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL pública final do site (com https://, sem barra no final), usada para
# montar os links de retorno do Mercado Pago e o notification_url do webhook.
# Opcional: se não for definida, cai automaticamente para VERCEL_URL (que a
# própria Vercel já injeta em todo deploy). Defina esta variável quando tiver
# um domínio próprio configurado, para os links sempre apontarem para ele.
SITE_URL=

# Painel do Supabase > Project Settings > Data API (URL do projeto) e
# > Project Settings > API Keys > "secret" key (chave de serviço — NUNCA a
# chave "anon"/pública). Usada apenas por api/leads/[kind].js para salvar os
# formulários "Quero fazer parte" e "Quero servir" nas tabelas
# public.membership_requests e public.volunteer_requests.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ============================================================
# FRONTEND (prefixo VITE_ — estas SÃO expostas no navegador; nunca
# coloque aqui nada sensível, como o MP_ACCESS_TOKEN ou o SUPABASE_SECRET_KEY acima)
# ============================================================

# Normalmente não é necessário: como o frontend e as funções de /api são
# publicados juntos no mesmo domínio, o app já chama "/api" por padrão.
# Só preencha isto se a API for hospedada separadamente, em outro domínio.
VITE_API_URL=
